5 'SAVE"AUTOEXEC.BAS
10 COLOR15,1,1:SCREEN 1,1:WIDTH 32:KEY OFF:CLS
15 DEFUSR=&H7E:A=USR(0):BLOAD"PCG.PAT",S:BLOAD"PCG.COL",S
20 CLEAR 3000,&HBFFF:DEFINT A-Z
25 BLOAD"MAP.BIN"
30 DEFUSR=&HC024:DEFUSR1=&HC000:DEFUSR2=&HC003:DEFUSR3=&HC00F:DEFUSR4=&HC02A:DEFUSR5=&HC02D
40 LN#=135.0665902:LT#=34.64803
50 DL#=135.1866995:DT#=34.68263
60 MK=1:MX=117:MY=76:DI=-1:PL#=LN#:PT#=LT#:TIME=0:SP#=0:SD#=0:DIM OX(15),OY(15)
70 A=USR4(DL#):A=USR5(DT#)
80 A=USR(4)
85 FOR I=0 TO 15:READ OX(I),OY(I):NEXT
90 FOR I=0 TO 4:PP$="":FOR J=0 TO 7:READ A$:PP$=PP$+CHR$(VAL("&H"+A$)):NEXT:SPRITE$(I)=PP$:NEXT
130 '1,8,11,15
135 '1,6,8,15
140 PUT SPRITE 0,(MX,MY),1,0
150 PUT SPRITE 1,(MX,MY),8,1
160 PUT SPRITE 2,(MX,MY),11,2
170 GOSUB 7000
500 CLS
600 'MAIN LOOP
610 K$=INKEY$:IF K$=CHR$(27) THEN GOSUB 1500:GOTO 700
615 GOSUB 8000:GOTO 630
630 IF LN#>151 THEN LN#=151 ELSE IF LN#<123 THEN LN#=123
660 IF LT#>46 THEN LT#=46 ELSE IF LT#<22 THEN LT#=22
670 GOTO 700
700 A=USR1(LN#):A=USR2(LT#):GOSUB 1200:GOSUB 1300:GOSUB 1400
710 A=USR(5): IF USR(7)<>0 THEN 610
810 FOR BF=0 TO 3:IF USR(BF)<>0 GOTO BLOAD USR3("A:\T00\T00_00.BIN"),USR(8):NEXT ELSE NEXT
910 A=USR(6)
920 GOTO 610
950 'DIR OFFSETS: 0=N 4=E 8=S 12=W
960 DATA 0,-8,3,-7,6,-6,7,-3,8,0,7,3,6,6,3,7
970 DATA 0,8,-3,7,-6,6,-7,3,-8,0,-7,-3,-6,-6,-3,-7
1000 'SPRITE
1010 DATA 7C,82,2A,46,81,41,92,6C
1020 DATA 00,7C,44,00,38,38,6C,00
1030 DATA 82,00,90,B8,46,06,00,00
1140 DATA 82,00,80,80,06,06,00,00
1145 DATA 00,00,3C,3C,3C,3C,00,00
1150 'DATA 38,44,34,44,8A,44,52,A1
1160 'DATA 00,00,00,00,00,00,04,06
1170 'DATA 00,10,08,38,74,38,28,58
1180 'DATA 00,28,00,00,00,00,00,00
1200 'DIR TO DEST: 0=N 4=E 8=S 12=W -1=SAME
1210 DI=USR(9):IF DI<0 THEN PUT SPRITE 4,(-32,-32),8,4:RETURN
1275 PUT SPRITE 4,(MX+OX(DI)*2,MY+OY(DI)*2),8,4
1280 RETURN
1300 'SPEED KM/H FROM LAST FRAME
1310 ET!=TIME
1320 IF ET! = 0 THEN RETURN
1325 IF LN#=PL# THEN IF LT#=PT# THEN SP#=0:RETURN
1330 LX#=(LN#-PL#)*111.32*COS((LT#+PT#)*.008726646):LY#=(LT#-PT#)*111.32
1340 DS#=SQR(LX#*LX#+LY#*LY#):SD#=SD#+DS#:PL#=LN#:PT#=LT#
1350 IF ET! < 15 THEN RETURN
1355 SP#=SD#*216000#/ET!:SD#=0:TIME=0
1360 RETURN
1400 'PRINT SPEED
1420 LOCATE 0,0:PRINT USING "###.#######,##.####### #####km/h";LN#;LT#;INT(SP#)
1430 RETURN
1500 'DEST INPUT
1510 PUT SPRITE 4,(-32,-32),8,4:CLS
1520 PRINT "DEST LON ";:INPUT DL#
1530 PRINT "DEST LAT ";:INPUT DT#
1540 IF DL#<123 THEN DL#=123 ELSE IF DL#>151 THEN DL#=151
1550 IF DT#<22 THEN DT#=22 ELSE IF DT#>46 THEN DT#=46
1560 A=USR4(DL#):A=USR5(DT#):A=USR(4)
1570 PL#=LN#:PT#=LT#:SD#=0:SP#=0:TIME=0:CLS
1580 RETURN
7000 ' GPS initialize
7010 DQ$=CHR$(&H22)
7020 CALL COMINI("0:8N1NH",9600)
7030 OPEN "COM:" AS #1
7040 PRINT #1,"$PCAS03,9,0,0,0,0,0,0,0*0B"
7050 FOR I=0 TO 200:NEXT
7060 C=LOC(1):IF C>0 THEN A$=INPUT$(C,#1)
7070 RETURN
8000 ' GPS receive
8010 K$=INKEY$:IF K$=CHR$(27) THEN GOSUB 1500:RETURN ELSE C=LOC(1):IF C=0 THEN 8010
8020 INPUT #1,A$
8030 IF A$<>"$GNGGA" THEN 8010
8040 INPUT #1,TM$
8050 INPUT #1,L2$
8060 INPUT #1,NS$
8070 INPUT #1,L3$
8080 INPUT #1,EW$
8090 IF L2$="" OR L3$="" THEN 8010
8100 D$=L2$:GOSUB 8500:LT#=R#
8110 IF NS$="S" THEN LT#=-LT#
8120 D$=L3$:GOSUB 8500:LN#=R#
8130 IF EW$="W" THEN LN#=-LN#
8140 RETURN
8500 ' ddmm.mmmm to degrees
8510 V0#=VAL(D$)
8520 V1#=INT(V0#/100)
8530 V2#=(V0#-V1#*100)/60
8540 R#=V1#+V2#
8550 RETURN
